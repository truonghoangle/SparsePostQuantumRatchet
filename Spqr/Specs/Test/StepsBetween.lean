def steps_between_val (start end_ : I32) : Usize × Option Usize :=
  if start.val ≤ end_.val then
    match UScalar.tryMkOpt .Usize (end_.val - start.val).toNat with
    | some n => (n, some n)                -- Ok(steps) => (steps, Some(steps))
    | none   => (core.num.Usize.MAX, none) -- Err(_)    => (usize::MAX, None)
  else
    (0#usize, some 0#usize)                -- (0, Some(0))

