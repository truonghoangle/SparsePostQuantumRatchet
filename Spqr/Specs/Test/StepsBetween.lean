@[step]
theorem steps_between_spec
    (start end_ : I32) :
    sb start end_ ⦃ (pair : Usize × Option Usize) =>
      if start.val ≤ end_.val then
        let diff := (end_.val - start.val).toNat
        match pair.2 with
        | some hi => diff ≤ Usize.max ∧ pair.1.val = diff ∧ hi.val = diff
        | none    => ¬ (diff ≤ Usize.max) ∧ pair.1.val = Usize.max
      else
        pair.1.val = 0 ∧ pair.2 = some pair.1 ⦄ := by
  rw [steps_between_eq]
  simp only [WP.spec_ok, steps_between_val]
  have htry := UScalar.tryMkOpt_eq .Usize (end_.val - start.val).toNat
  by_cases hle : start.val ≤ end_.val
  · -- Case: start ≤ end (non-empty range)
    rw [if_pos hle]
    generalize UScalar.tryMkOpt .Usize (end_.val - start.val).toNat = o at htry ⊢
    cases o with
    | some n =>
      -- Sub-case: diff fits in Usize — tryMkOpt returned some n
      simp only [if_pos hle]
      obtain ⟨hval, hbounds⟩ := htry
      exact ⟨by scalar_tac, hval, hval⟩
    | none =>
      -- Sub-case: diff overflows Usize — tryMkOpt returned none
      simp only [core.num.Usize.MAX, Usize.ofNatCore_val_eq, if_pos hle]
      exact ⟨by scalar_tac, rfl⟩
  · -- Case: start > end (empty range)
    rw [if_neg hle, if_neg hle]
    simp only [UScalar.ofNatCore_val_eq]
    constructor <;> trivial

